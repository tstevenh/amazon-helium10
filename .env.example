# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_DB=ppc_os
POSTGRES_USER=ppc_os
POSTGRES_PASSWORD=changeme

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Fernet (token encryption) ─────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=changeme-generate-with-Fernet.generate_key

# ── Amazon Advertising API ────────────────────────────────────────────────
# Create an app at https://advertising.amazon.com/API/docs/en-us/setting-up/overview
AMAZON_CLIENT_ID=changeme
AMAZON_CLIENT_SECRET=changeme
# Must be registered in your Amazon LWA app exactly as written here.
AMAZON_REDIRECT_URI=http://localhost:8000/accounts/oauth/callback
AMAZON_API_BASE_URL=https://advertising-api.amazon.com

# Set to "true" to skip real Amazon API calls and return mock profile data.
# Required when no real credentials are available (CI, first-run dev, etc.).
AMAZON_MOCK_MODE=false
AMAZON_FULL_SYNC_MAX_PAGES=0  # 0 = unlimited full sync; set e.g. 50 for emergency page cap

# ── Seed users ────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=ChangeMe123!

# ── Runtime ───────────────────────────────────────────────────────────────
ENV=dev
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Background worker (Plan 2) ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# Hours between automatic full syncs. 0 disables the schedule.
SYNC_SCHEDULE_HOURS=6
